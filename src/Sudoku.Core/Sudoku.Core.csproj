<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<RootNamespace>Sudoku</RootNamespace>
		<!--<Platforms>AnyCPU;x64;x86</Platforms>-->
		<Description>Provides all core implementations of sudoku API.</Description>
		<DocumentationFile>Sudoku.Core.xml</DocumentationFile>
	</PropertyGroup>

	<Choose>
		<When Condition="$(Platforms.Contains('x64')) or $(Platforms.Contains('amd64'))">
			<!--Enables Z3 to support SMT solver-->
			<PropertyGroup>
				<DefineConstants>$(DefineConstants);ENABLE_SMT_SOLVER</DefineConstants>
			</PropertyGroup>
		</When>
		<Otherwise>
			<!--CACHE_CANDIDATE_MAPS;TRANSFORM_LESS_GIVEN_STANDARD_SUDOKU_PUZZLES_TO_SUKAKU-->
			<PropertyGroup>
				<DefineConstants>$(DefineConstants)</DefineConstants>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<ItemGroup Condition="$(Platforms.Contains('x64')) or $(Platforms.Contains('amd64'))">
		<PackageReference Include="Microsoft.Z3" Version="4.12.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\System\SystemExtensions.csproj" />
	</ItemGroup>

	<!-- Copies the native shared library from miscellaneous/dll/clingo to the output directory (silently skipped if not downloaded; the DllImport resolver of ClingoInterop falls back to the system search) -->
	<ItemGroup>
		<None
			Include="../../miscellaneous/dll/clingo/win-x64/clingo.dll"
			Link="clingo.dll" CopyToOutputDirectory="PreserveNewest"
			Condition="'$(OS)' == 'Windows_NT' and Exists('../../miscellaneous/dll/clingo/win-x64/clingo.dll')" />
		<None
			Include="../../miscellaneous/dll/clingo/linux-x64/libclingo.so"
			Link="libclingo.so" CopyToOutputDirectory="PreserveNewest"
			Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('../../miscellaneous/dll/clingo/linux-x64/libclingo.so')" />
		<None
			Include="../../miscellaneous/dll/clingo/linux-arm64/libclingo.so"
			Link="libclingo.so" CopyToOutputDirectory="PreserveNewest"
			Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('../../miscellaneous/dll/clingo/linux-arm64/libclingo.so')" />
		<None
			Include="../../miscellaneous/dll/clingo/osx-x64/libclingo.dylib"
			Link="libclingo.dylib" CopyToOutputDirectory="PreserveNewest"
			Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('../../miscellaneous/dll/clingo/osx-x64/libclingo.dylib')" />
		<None
			Include="../../miscellaneous/dll/clingo/osx-arm64/libclingo.dylib"
			Link="libclingo.dylib" CopyToOutputDirectory="PreserveNewest"
			Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('../../miscellaneous/dll/clingo/osx-arm64/libclingo.dylib')" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\CoreResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>CoreResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\CoreResources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>CoreResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
